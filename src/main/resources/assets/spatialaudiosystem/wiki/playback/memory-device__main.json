{
  "schema": "manta-playback/1",
  "loop": true,
  "restartHoldMs": 1500,
  "steps": [
    {
      "target": {
        "classes": [
          "rec-file-btn"
        ]
      },
      "do": "click",
      "say": "sas.wiki.play.rec.file",
      "holdMs": 1500
    },
    {
      "target": {
        "classes": [
          "rec-clear-btn"
        ]
      },
      "do": "click",
      "say": "sas.wiki.play.rec.clear",
      "holdMs": 1400
    },
    {
      "target": {
        "classes": [
          "rec-file-btn"
        ]
      },
      "do": "click",
      "holdMs": 900
    },
    {
      "target": {
        "classes": [
          "rec-play-btn"
        ]
      },
      "do": "hover",
      "say": "sas.wiki.play.rec.play",
      "holdMs": 1300
    },
    {
      "target": {
        "classes": [
          "rec-output-slot"
        ]
      },
      "do": "slot",
      "quick": true,
      "say": "sas.wiki.play.rec.take",
      "holdMs": 1100
    },
    {
      "target": {
        "classes": [
          "rec-start-btn"
        ]
      },
      "do": "click",
      "say": "sas.wiki.play.rec.start",
      "holdMs": 3000
    },
    {
      "target": {
        "classes": [
          "rec-output-slot"
        ]
      },
      "do": "hover",
      "say": "sas.wiki.play.rec.done",
      "holdMs": 1900
    }
  ]
}
